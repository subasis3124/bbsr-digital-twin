# ============================================================
# Bhubaneswar Digital Twin — Environment Configuration Template
# Copy this file to .env and populate values appropriately.
# ============================================================

# Application Environment (development, testing, production)
ENV=development
DEBUG=True

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_DB=bbsr_digital_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_pwd@localhost:5432/bbsr_digital_twin

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=*

# GIS & Map Token Configuration
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_access_token_here

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Natural Language AI Interface Configuration (Phase 16)
AI_PROVIDER=mock
AI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CESIUM_ION_TOKEN=your_cesium_ion_access_token_here
